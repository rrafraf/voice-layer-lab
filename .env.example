# Create this as .env.local. Never commit the real value.
GEMINI_API_KEY=

# Optional overrides
VOICE_PROVIDER=gemini
VOICE_MODE=conversation
VOICE_LANGUAGE=en-US
VOICE_INPUT_DEVICE=Microphone (2- Realtek High Definition Audio)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE_UI_PORT=4317
VOICE_UI_OPEN=1

# Optional extension/MCP client override
VOICE_LAB_SERVER_URL=http://127.0.0.1:4317

# Optional Gemini TTS (request/response recitation, not Live)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

